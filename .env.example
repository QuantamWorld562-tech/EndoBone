# EndoBone AI Frontend - Environment Configuration
# Copy this file to .env.local and update values accordingly

# API Configuration
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_IMAGING_SERVICE=http://localhost:5000
REACT_APP_API_TIMEOUT=30000

# Application Environment
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=true

# Feature Flags
REACT_APP_ENABLE_3D_VIEWER=true
REACT_APP_ENABLE_PDF_EXPORT=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_MOCK_DATA=true

# Analytics (optional)
REACT_APP_ANALYTICS_ID=
REACT_APP_SENTRY_DSN=

# Authentication (if implemented)
REACT_APP_AUTH_ENABLED=false
REACT_APP_AUTH_PROVIDER=
REACT_APP_AUTH_DOMAIN=

# 3D Visualization
REACT_APP_BABYLON_JS_CDN=https://cdn.babylonjs.com/babylon.js
REACT_APP_THREE_JS_CDN=https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js

# Data Caching
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_TTL=300000

# Logging
REACT_APP_LOG_LEVEL=info
REACT_APP_LOG_TO_CONSOLE=true

# PDF Generation
REACT_APP_PDF_SERVICE_URL=
REACT_APP_PDF_LOGO_URL=

# Security
REACT_APP_CONTENT_SECURITY_POLICY=true
REACT_APP_HTTPS_ONLY=false

# Development Tools
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_ENABLE_NETWORK_LOGGING=true

# Feature-specific URLs
REACT_APP_DOCUMENTATION_URL=https://docs.endobone.ai
REACT_APP_SUPPORT_URL=https://support.endobone.ai
REACT_APP_TERMS_URL=https://endobone.ai/terms
REACT_APP_PRIVACY_URL=https://endobone.ai/privacy
